{
    "name": "fxfavalessa/fx-framework",
    "description": "Nucleo reutilizavel para aplicacoes PHP da familia FX.",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "illuminate/container": "^10.48",
        "illuminate/database": "^10.48",
        "illuminate/http": "^10.48",
        "smarty/smarty": "^4.5.7",
        "symfony/console": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/polyfill-mbstring": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Fx\\Framework\\": [
                "packages/core/src/",
                "packages/http/src/",
                "packages/database/src/",
                "packages/view/src/",
                "packages/console/src/",
                "packages/auth/src/",
                "packages/validation/src/",
                "packages/windows/src/",
                "packages/wordpress/src/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fx\\Framework\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fxartisan"
    ],
    "replace": {
        "fxfavalessa/fx-core": "self.version",
        "fxfavalessa/fx-http": "self.version",
        "fxfavalessa/fx-database": "self.version",
        "fxfavalessa/fx-view": "self.version",
        "fxfavalessa/fx-console": "self.version",
        "fxfavalessa/fx-auth": "self.version",
        "fxfavalessa/fx-validation": "self.version",
        "fxfavalessa/fx-windows": "self.version",
        "fxfavalessa/fx-wordpress": "self.version"
    },
    "config": {
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
