{
    "name": "fxfavalessa/fx-framework",
    "description": "Nucleo reutilizavel para aplicacoes PHP da familia FX.",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "illuminate/container": "^10.48",
        "illuminate/database": "^10.48",
        "illuminate/http": "^10.48",
        "smarty/smarty": "^4.5.7",
        "symfony/console": "^6.4",
        "symfony/http-foundation": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Fx\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fx\\Framework\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/fxartisan"
    ],
    "config": {
        "optimize-autoloader": false,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
