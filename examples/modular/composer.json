{
    "name": "fxfavalessa/example-modular",
    "description": "Verificacao isolada FX modular",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "fxfavalessa/fx-http": "@dev",
        "fxfavalessa/fx-database": "@dev",
        "fxfavalessa/fx-view": "@dev",
        "fxfavalessa/fx-console": "@dev",
        "fxfavalessa/fx-auth": "@dev",
        "fxfavalessa/fx-windows": "@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": false
    }
}
