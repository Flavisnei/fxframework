{
    "name": "fxfavalessa/example-modules",
    "description": "Exemplo isolado do ciclo de modulos FX.",
    "license": "proprietary",
    "repositories": [{"type": "path", "url": "../../packages/*", "options": {"symlink": false}}],
    "require": {"fxfavalessa/fx-modules": "@dev", "fxfavalessa/fx-console": "@dev"},
    "autoload": {"psr-4": {"Example\\": "modules/hello/src/"}},
