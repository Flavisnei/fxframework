#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fx\Framework\Console\Artisan;

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../../../../autoload.php',
];

foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        if (in_array($argv[1] ?? null, ['-v', '--version', 'version'], true)) {
            foreach (\Fx\Framework\Console\VersionInfo::all() as $name => $version) {
                echo $name . ': ' . $version . PHP_EOL;
            }
            exit(0);
        }
        exit(Artisan::fromCurrentDirectory()->run());
    }
}

fwrite(STDERR, "Autoload do Composer nao encontrado. Execute composer install.\n");
exit(1);
