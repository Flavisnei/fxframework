#!/usr/bin/env php
<?php

declare(strict_types=1);

use Fx\Framework\Console\Artisan;

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        if (($argv[1] ?? null) === '-v') {
            fwrite(STDOUT, "FX Artisan: " . \Fx\Framework\Console\Application::VERSION . PHP_EOL);
            fwrite(STDOUT, "FX Framework: " . \Fx\Framework\Console\Application::VERSION . PHP_EOL);
            exit(0);
        }
        exit(Artisan::fromCurrentDirectory()->run());
    }
}

fwrite(STDERR, "Autoload do Composer nao encontrado. Execute composer install.\n");
exit(1);
